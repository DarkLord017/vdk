{
  "name": "vdk",
  "private": true,
  "version": "0.0.0",
  "description": "VDK — Vara Development Kit: themeable React components and a live theme playground for Vara Network",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter @vara-dk/playground dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint:tokens": "node scripts/check-tokens.mjs"
  },
  "pnpm": {
    "overrides": {
      "@polkadot/util": "13.5.9",
      "@polkadot/util-crypto": "13.5.9"
    }
  }
}
